    },
    {
      "name": "LevelMeter_3",
      "module_class": "MusicRaTLevelMeter",
      "outputs": [{ "system_id": 10, "instance_id": 6 }, { "system_id": 30, "instance_id": 3 }],
      "inputs": [{ "source_system_id": 10, "source_instance_id": 5 }],
      "params": { "clipping_threshold": 1.0 }
    },
    {
