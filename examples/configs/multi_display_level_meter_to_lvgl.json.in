      "module_address": { "system_id": 40, "instance_id": 2 },
      "outputs": [],
      "inputs": [{ "source_system_id": 10, "source_instance_id": 4 }]
    },
    {
      "name": "WidgetUpdateMerger_1",
      "module_class": "MusicRaTWidgetUpdateMerger",
      "outputs": [{ "system_id": 50, "instance_id": 4 }],
      "inputs": [{ "source_system_id": 50, "source_instance_id": 1 }],
      "synced_inputs": [{ "source_system_id": 50, "source_instance_id": 2 }]
    },
    {
      "name": "LvglWidgetSink_1",
      "module_class": "MusicRaTLvglWidgetSink",
      "outputs": [{ "system_id": 60, "instance_id": 1 }],
      "inputs": [],
      "synced_inputs": [{ "source_system_id": 50, "source_instance_id": 4 }],
      "period_ms": 10,
      "params": { "manifest_path": "@PROJECT_SOURCE_DIR@/examples/configs/multi_display_level_meter.lvgl.json", "display_instance_id": "display-1", "width": 320, "height": 240, "backend": 0, "device_path": "", "connector_id": -1, "window_title": "MusicRaT Display 1", "device_id": 1, "control_bindings": [] }
