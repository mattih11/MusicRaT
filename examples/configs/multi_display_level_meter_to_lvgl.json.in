      "params": { "frequency_hz": 330.0, "amplitude": 0.3, "sample_rate_hz": 48000.0, "phase_offset": 0.0, "enabled": true }
    },
    {
      "name": "LevelMeter_2",
      "module_class": "MusicRaTLevelMeter",
      "outputs": [{ "system_id": 10, "instance_id": 4 }, { "system_id": 30, "instance_id": 2 }],
      "inputs": [{ "source_system_id": 10, "source_instance_id": 3 }],
      "params": { "clipping_threshold": 1.0 }
    },
    {
      "name": "LevelMeterUiAdapter_2",
      "module_class": "MusicRaTLevelMeterUiAdapter",
      "outputs": [{ "system_id": 50, "instance_id": 2 }],
      "inputs": [{ "source_system_id": 30, "source_instance_id": 2 }],
      "params": { "bindings": [{ "binding_id": 2, "surface_id": "main", "widget_id": "peak-meter-2", "property": 0, "selector": 0, "channel": 0 }] }
    },
    {
      "name": "NullSink_2",
