{
  "app_name": "MusicRaTInteractiveGainPan",
  "modules": [
    {
      "name": "LvglWidgetSink_1",
      "module_class": "MusicRaTLvglWidgetSink",
      "outputs": [{ "system_id": 60, "instance_id": 1 }],
      "inputs": [],
      "synced_inputs": [],
      "period_ms": 10,
      "params": {
        "manifest_path": "@MUSICRAT_LVGL_MANIFEST_DIR@/interactive_gain_pan.lvgl.json",
        "display_instance_id": "display-1",
        "width": 800,
        "height": 480,
        "backend": @MUSICRAT_LVGL_EXAMPLE_BACKEND@,
        "device_path": "@MUSICRAT_LVGL_EXAMPLE_DEVICE_PATH@",
        "connector_id": -1,
        "window_title": "MusicRaT Gain and Pan",
        "device_id": 1,
        "control_bindings": [
          { "widget_id": "gain", "endpoint_id": 1, "origin_id": 1, "kind": 0 },
          { "widget_id": "pan", "endpoint_id": 2, "origin_id": 2, "kind": 0 }
        ]
      }
    },
    {
      "name": "GainMapper_1",
      "module_class": "MusicRaTControlMapper",
      "outputs": [{ "system_id": 20, "instance_id": 1 }],
      "inputs": [{ "source_system_id": 60, "source_instance_id": 1 }],
      "synced_inputs": [{ "source_system_id": 20, "source_instance_id": 3 }],
      "params": { "bindings": [{
        "binding_id": 1,
        "source_device_id": 1,
        "source_endpoint_id": 1,
        "target_parameter_id": 1,
        "source_kind": 0,
        "mode": 0,
        "curve": 0,
        "pickup": 0,
        "source_minimum": 0.0,
        "source_maximum": 1.0,
        "target_minimum": 0.0,
        "target_maximum": 2.0,
        "scale": 1.0,
        "offset": 0.0,
        "dead_zone": 0.0,
        "quantization": 0.0,
        "hysteresis": 0.0,
        "pickup_tolerance": 0.01,
        "initial_value": 1.0,
        "invert": false
      }] }
    },
    {
      "name": "PanMapper_1",
      "module_class": "MusicRaTControlMapper",
      "outputs": [{ "system_id": 20, "instance_id": 2 }],
      "inputs": [{ "source_system_id": 60, "source_instance_id": 1 }],
      "synced_inputs": [],
      "params": { "bindings": [{
        "binding_id": 2,
        "source_device_id": 1,
        "source_endpoint_id": 2,
        "target_parameter_id": 1,
        "source_kind": 0,
        "mode": 0,
        "curve": 0,
        "pickup": 0,
        "source_minimum": 0.0,
        "source_maximum": 1.0,
        "target_minimum": -1.0,
        "target_maximum": 1.0,
        "scale": 1.0,
        "offset": 0.0,
        "dead_zone": 0.0,
        "quantization": 0.0,
        "hysteresis": 0.0,
        "pickup_tolerance": 0.01,
        "initial_value": 0.0,
        "invert": false
      }] }
    },
    {
      "name": "SineOscillator_1",
      "module_class": "MusicRaTSineOscillator",
      "outputs": [{ "system_id": 10, "instance_id": 1 }],
      "inputs": [],
      "period_ms": 10,
      "params": {
        "frequency_hz": 440.0,
        "amplitude": 0.15,
        "sample_rate_hz": 48000.0,
        "phase_offset": 0.0,
        "enabled": true
      }
    },
    {
      "name": "Gain_1",
      "module_class": "MusicRaTGain",
      "outputs": [
        { "system_id": 10, "instance_id": 2 },
        { "system_id": 20, "instance_id": 3 }
      ],
      "inputs": [{ "source_system_id": 10, "source_instance_id": 1 }],
      "synced_inputs": [{ "source_system_id": 20, "source_instance_id": 1 }],
      "params": {
        "gain": 1.0,
        "smoothing_samples": 64,
        "muted": false,
        "invert_polarity": false
      }
    },
    {
      "name": "StereoPanner_1",
      "module_class": "MusicRaTStereoPanner",
      "outputs": [{ "system_id": 10, "instance_id": 3 }],
      "inputs": [{ "source_system_id": 10, "source_instance_id": 2 }],
      "synced_inputs": [{ "source_system_id": 20, "source_instance_id": 2 }],
      "params": {
        "pan": 0.0,
        "pan_law": 1,
        "smoothing_samples": 64
      }
    },
    {
      "name": "AudioDeviceSink_1",
      "module_class": "MusicRaTAudioDeviceSink",
      "module_address": { "system_id": 40, "instance_id": 1 },
      "outputs": [],
      "inputs": [{ "source_system_id": 10, "source_instance_id": 3 }],
      "params": {
        "device_name": "",
        "sample_rate_hz": 48000,
        "channel_count": 2,
        "period_frames": 480
      }
    }
  ]
}