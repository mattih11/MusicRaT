{
  "app_name": "MusicRaTAudioFilePlayerToWav",
  "modules": [
    {
      "name": "DeckControlSource_1",
      "module_class": "MusicRaTDeckControlSource",
      "outputs": [
        { "system_id": 20, "instance_id": 2 }
      ],
      "inputs": [],
